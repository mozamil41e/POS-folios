{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn", "vitest"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": "warn",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react/immutability": "warn"
  },
  "ignorePatterns": ["dist/**", "server.js", "coverage/**", "node_modules/**", "data/**"]
}
