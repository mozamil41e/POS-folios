# Environment variables used by Mizan POS.
# The app does not read a .env file: in production set them in Hostinger hPanel
# (Node.js app -> Environment variables); locally set them in your shell.
# Never commit real values.

# SETUP_TOKEN: Required in production (set it in Hostinger hPanel).
# First-run setup (creating the first administrator) only succeeds with this
# value, and registration closes for good once any user exists.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave it unset only for local development.
SETUP_TOKEN=""

# TRUST_PROXY: Optional. How many proxies sit in front of the app (Express "trust proxy").
# Unset = 1 in production (Hostinger serves the app through one proxy), none in development.
# Client IPs from X-Forwarded-For feed the sign-in and public-page rate limits.
# Use "false" when the app is reached directly, or a number / "loopback" / CIDR list.
TRUST_PROXY=""

# NODE_ENV: "production" on the server. `npm start` (the built server.js) runs in
# production mode even without it; `npm run dev` uses the Vite dev server.
NODE_ENV=""

# PORT: Optional. Port the server listens on (default 3000). Hostinger sets it.
PORT=""

# MIZAN_DB_PATH: Optional. SQLite database file (default ./data/mizan-pos.db).
# Used by the tests and scripts; on Hostinger the default is wiped on every
# deploy until the move to MariaDB (R3).
MIZAN_DB_PATH=""
